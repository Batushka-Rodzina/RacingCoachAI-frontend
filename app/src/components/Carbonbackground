// src/components/CarbonBackground.tsx
// Lekkie tło z teksturą karbonu - bez animacji, minimalne obciążenie
import React from 'react'

interface CarbonBackgroundProps {
	withGradient?: boolean
	className?: string
}

const CarbonBackground: React.FC<CarbonBackgroundProps> = ({ 
	withGradient = true,
	className = '' 
}) => {
	return (
		<div className={`fixed inset-0 -z-10 bg-neutral-950 ${className}`}>
			{/* Carbon texture */}
			<div 
				className="absolute inset-0 opacity-40"
				style={{
					backgroundImage: `
						linear-gradient(45deg, #0f0f0f 25%, transparent 25%),
						linear-gradient(-45deg, #0f0f0f 25%, transparent 25%),
						linear-gradient(45deg, transparent 75%, #0f0f0f 75%),
						linear-gradient(-45deg, transparent 75%, #0f0f0f 75%)
					`,
					backgroundSize: '4px 4px',
					backgroundPosition: '0 0, 0 2px, 2px -2px, -2px 0px'
				}}
			/>

			{/* Optional gradient accents */}
			{withGradient && (
				<div 
					className="absolute inset-0 pointer-events-none"
					style={{
						background: `
							radial-gradient(ellipse at 20% 0%, rgba(255, 107, 0, 0.03) 0%, transparent 50%),
							radial-gradient(ellipse at 80% 100%, rgba(212, 175, 55, 0.02) 0%, transparent 50%)
						`
					}}
				/>
			)}
		</div>
	)
}

export default CarbonBackground