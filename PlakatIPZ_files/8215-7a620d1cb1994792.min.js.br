const tseslint = require('typescript-eslint')
const figmaPlugin = require('@figma/eslint-plugin-figma-plugins')

module.exports = tseslint.config(
  eslint.configs.recommended,
  // @typescript-eslint/recommended-type-checked is too aggressive for
  // widget code...it doesn't seem to like JSX element return values or
  // unbundling the \`widget\` object for use* hooks. So we'll use
  // tseslint.configs.recommended instead.
  tseslint.configs.recommended,
  {
    plugins: {
      '@figma/figma-plugins': figmaPlugin,
    },
    rules: {
      ...figmaPlugin.configs.recommended.rules,
      // allow underscore-prefixing of unused variables
      '@typescript-eslint/no-unused-vars': [
        'error',
        {
          argsIgnorePattern: '^_',
          varsIgnorePattern: '^_',
          caughtErrorsIgnorePattern: '^_',
        },
      ],
    },
  },
  {
    ignores: ['code.js', 'dist', 'eslint.config.js'],
  },
)
`}function s(e){let t={"@eslint/js":"^9.39.4","@figma/eslint-plugin-figma-plugins":"*","@figma/plugin-typings":"*",eslint:"^9.39.4",typescript:"^5.9.3","typescript-eslint":"^8.57.1"};return e.isWidget&&(t={...t,"@figma/widget-typings":"*"}),e.useEsbuild&&(t={...t,esbuild:"*"}),l(t)}function o(e){let t={build:"tsc -p tsconfig.json",watch:"npm run build -- --watch",lint:"eslint .","lint:fix":"eslint . --fix"};return e.isWidget&&e.useEsbuild&&(t={...t,build:"esbuild widget-src/code.tsx --bundle --outfile=dist/code.js --target=es2020",tsc:"tsc --noEmit -p widget-src"}),l(t)}function l(e){let t=Object.keys(e).sort(),i={};for(let r of t)i[r]=e[r];return i}let d=`const { widget } = figma
