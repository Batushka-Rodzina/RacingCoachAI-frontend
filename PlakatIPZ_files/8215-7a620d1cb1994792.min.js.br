  shape.shapeType = 'ROUNDED_RECTANGLE';
  shape.x = i * (shape.width + 200);
  shape.fills = [{ type: 'SOLID', color: { r: 1, g: 0.5, b: 0 } }];
  figma.currentPage.appendChild(shape);
  nodes.push(shape);
