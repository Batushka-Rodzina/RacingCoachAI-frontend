_element.tsx */\n  user-select: none;\n  -webkit-user-select: none;\n}\n/**\n  Math for the indicator we are using to show if a thread is pinned as part of\n  #exp-pinned-comments! This icon sits in the top-right corner of the cluster\n  element and should shift as the radius expands with a scale transformation:\n\n          , - ~ ~ ~ - ,\n      , '               ' ,     ,\n    ,                       ,     ,\n    ,                         ,     ,\n  ,                   r1      ,     ,\n  ,             ------------- , --- ,\n  ,             |             , |   ,\n    ,            ------- r2 - , --  ,\n    ,                       ,     ,\n      ,                  , '\n        ' - , _ _ _ ,  '\n\n  r2 = 1.1 * r1 (or 1.2, in the case of .emphasized)\n  d1 and d2 are equal to 2r1 and 2r2, respectively\n\n  Since we're shifting the top-left coordinates of the pin indicator, we need\n  to calculate the delta between the two radii, and derive the x/y from the\n  hypotenuse of the triangle created\n\n  ((scaleFactor * d1 - d1) / 2)^2 = delta^2\n  delta = (scaleFactor * d1 - d1) / 2 / sqrt(2)\n*/\n.comment_cluster_element_updatable--avatarCluster--dmb5c {\n  display: flex;\n  width: 64px;\n  height: 64px;\n  border-radius: 50%;\n  font-family: Inter, sans-serif;\n  font-weight: 400;\n  font-size: 13px;\n}\n.comment_cluster_element_updatable--avatarCluster--dmb5c:hover .comment_cluster_element_updatable--pinnedThreadToFileIndicator--mVwc8 {\n    transform: translate(\n      2.26274px,\n      -2.26274px\n    );\n  }\n.comment_cluster_element_updatable--emphasized--f73nA .comment_cluster_element_updatable--pinnedThreadToFileIndicator--mVwc8,\n  .comment_cluster_element_updatable--emphasized--f73nA:hover .comment_cluster_element_updatable--pinnedThreadToFileIndicator--mVwc8 {\n    transform: translate(\n      2.26274px,\n      -2.26274px\n    ) !important;\n  }\n.comment_cluster_element_updatable--pinnedThreadToFileIndicator--mVwc8 {\n  position: absolute;\n  top: 0px;\n  right: 0px;\n  /* stylelint-disable-next-line @fpl/no-manual-z-index */\n  z-index: 1;\n  width: 16px;\n  height: 16px;\n  border-radius: 100%;\n  justify-content: center;\n  align-items: center;\n  box-shadow: var(--elevation-200-canvas);\n  display: flex;\n  transform: scale(0);\n  opacity: 0;\n  transition:\n    250ms transform cubic-bezier(0.4, 0, 0, 1),\n    250ms opacity cubic-bezier(0.4, 0, 0, 1);\n}\n.comment_cluster_element_updatable--pinnedThreadToFileIndicator--mVwc8.comment_cluster_element_updatable--indicatorShown--wkBVc {\n    opacity: 1;\n    transform: scale(1);\n  }\n.comment_cluster_element_updatable--cornerCluster--qkPnt {\n  width: 24px;\n  height: 24px;\n}\n/* We are using a before pseudo element here because\n * We want to scale the cluster size on hover but not its\n * child elements.\n */\n.comment_cluster_element_updatable--avatarCluster--dmb5c::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n\n  background: var(--color-bg);\n  border-radius: 50%;\n  box-shadow: var(\n    --elevation-200-canvas,\n    0px 3px 6px rgba(0, 0, 0, 0.3),\n    0 0 1px rgba(0, 0, 0, 0.05)\n  );\n  transition: transform 250ms cubic-bezier(0.4, 0, 0, 1);\n}\n.comment_cluster_element_updatable--avatarCluster--dmb5c:hover::before {\n  transform: scale(1.1);\n}\n.comment_cluster_element_updatable--unread--4BKVF .comment_cluster_element_updatable--avatarCluster--dmb5c::before {\n  background: var(--color-bg-brand);\n  box-shadow: var(\n    --elevation-200-canvas,\n    0px 1px 2px rgba(0, 0, 0, 0.1),\n    0px 5px 8px rgba(0, 0, 0, 0.3)\n  );\n  color: #ffffff; /* stylelint-disable-line @figma/color-no-raw -- TODO: refactor with semantic token */\n}\n.comment_cluster_element_updatable--avatarCluster--dmb5c:hover > .comment_cluster_element_updatable--avatar--LMTNT {\n  transform: scale(0.2);\n  opacity: 0 !important;\n  transition: all 200ms ease-in-out;\n}\n.comment_cluster_element_updatable--avatarCluster--dmb5c:hover::after {\n